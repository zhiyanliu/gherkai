{
  "automationName": "UiAutomator2",
  "cases": [
    {
      "name": "点击：坐标为截图像素，取整",
      "call": "tap",
      "input": {"point": {"x": 100.4, "y": 200.6}},
      "commands": [
        {"method": "execute", "args": ["mobile: clickGesture", {"x": 100, "y": 201}]}
      ]
    },
    {
      "name": "长按：时长以毫秒传给驱动",
      "call": "longPress",
      "input": {"point": {"x": 50, "y": 60.5}, "durationMs": 800},
      "commands": [
        {"method": "execute", "args": ["mobile: longClickGesture", {"x": 50, "y": 61, "duration": 800}]}
      ]
    },
    {
      "name": "向下滚动：区域为屏高的 20% 到 80%，幅度为距离除以区域高度",
      "call": "scroll",
      "input": {"direction": "down", "distance": 720, "screen": {"width": 1080, "height": 2400}},
      "commands": [
        {"method": "execute", "args": ["mobile: scrollGesture", {"left": 0, "top": 480, "width": 1080, "height": 1440, "direction": "down", "percent": 0.5}]}
      ]
    },
    {
      "name": "向上滚动：没有距离时取缺省幅度",
      "call": "scroll",
      "input": {"direction": "up", "distance": null, "screen": {"width": 1080, "height": 2400}},
      "commands": [
        {"method": "execute", "args": ["mobile: scrollGesture", {"left": 0, "top": 480, "width": 1080, "height": 1440, "direction": "up", "percent": 0.5}]}
      ]
    },
    {
      "name": "向左滚动：幅度按区域宽度换算",
      "call": "scroll",
      "input": {"direction": "left", "distance": 270, "screen": {"width": 1080, "height": 2400}},
      "commands": [
        {"method": "execute", "args": ["mobile: scrollGesture", {"left": 0, "top": 480, "width": 1080, "height": 1440, "direction": "left", "percent": 0.25}]}
      ]
    },
    {
      "name": "向右滚动：幅度不超过 1",
      "call": "scroll",
      "input": {"direction": "right", "distance": 5000, "screen": {"width": 1080, "height": 2400}},
      "commands": [
        {"method": "execute", "args": ["mobile: scrollGesture", {"left": 0, "top": 480, "width": 1080, "height": 1440, "direction": "right", "percent": 1}]}
      ]
    },
    {
      "name": "输入：只发 mobile: type",
      "call": "typeText",
      "input": {"text": "hello 世界"},
      "commands": [
        {"method": "execute", "args": ["mobile: type", {"text": "hello 世界"}]}
      ]
    },
