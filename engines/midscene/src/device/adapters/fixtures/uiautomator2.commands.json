    {
      "name": "应用目标的 DeepLink：带包名，成功后核对前台包名",
      "call": "deepLink",
      "input": {"address": "myshop://cart?id=42&from=push", "appId": "com.example.shop"},
      "responses": {"getCurrentPackage": ["com.example.shop"]},
      "commands": [
        {"method": "execute", "args": ["mobile: deepLink", {"url": "myshop://cart?id=42&from=push", "package": "com.example.shop"}]},
        {"method": "getCurrentPackage", "args": []}
      ]
    },
    {
      "name": "网页目标的 DeepLink：交给系统浏览器，不核对前台包名",
      "call": "deepLink",
      "input": {"address": "https://shop.example/list?q=a+b&page=2#top", "appId": null},
      "commands": [
        {"method": "execute", "args": ["mobile: deepLink", {"url": "https://shop.example/list?q=a+b&page=2#top", "package": "com.android.chrome"}]}
      ]
    }
