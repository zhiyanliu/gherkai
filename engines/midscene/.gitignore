# ── midscene (.gitignore) — Node / TypeScript / Midscene.js ─────

# ── Dependencies ──
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── Build output ──
# dist/ 是 tsc 产物、发布物（package.json 的 files 白名单里；npm pack 不受本文件影响，已真跑核实）
dist/
build/
out/
*.tsbuildinfo
# npm pack 的本地产物（基底镜像本地态 build 用，不入库）——注：.gitignore 无行尾注释，故单独一行
*.tgz

# ── Package manager debug logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 锁文件保留入库(package-lock.json / pnpm-lock.yaml / yarn.lock)以保证可复现

# ── Midscene 运行产物 ──
midscene_run/
*.report.html
.midscene/

# ── Playwright (JS) ──
playwright-report/
test-results/
/playwright/.cache/
videos/
screenshots/

# ── Test / coverage ──
coverage/
.nyc_output/

# ── 本地敏感 / 配置 ──
.env
.env.*
!.env.example
