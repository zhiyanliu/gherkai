  "cards": [
    {
      "dot": "cyan",
      "title": "两个引擎对称",
      "items": [
        "平级、同一套协议：核心不感知 worker 的实现语言",
        "scenario 未标引擎时采用命令行指定的缺省引擎",
        "两个引擎的模型为当前值，真源在代码常量"
      ]
    },
    {
      "dot": "emerald",
      "title": "确定性 step 的加载者是 worker，不是 CLI",
      "items": [
        "本机档：worker 启动时从指定目录加载",
        "云端档：构建进 variant 镜像，提交侧指定目录无效"
      ]
    },
    {
      "dot": "violet",
      "title": "部署 provider 不在执行路径上",
      "items": [
        "仅 deploy / destroy / doctor 访问它",
        "云端执行时参与的只是它的产出：栈资源、推进函数、任务定义"
      ]
    }
