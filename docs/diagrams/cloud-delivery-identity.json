    "views": [
      {
        "id": "images-in",
        "label": "镜像挂哪",
        "focus": [
          "ghcr_base",
          "local_img",
          "ecr",
          "derived",
          "mapping"
        ],
        "note": "官方基底与你 build 的镜像怎么进账户、挂在哪个 revision 上？先同步或推送进你自己的 ECR，再从模板复制出这个 variant 的 revision 并登记进映射。"
      },
      {
        "id": "who-points",
        "label": "谁在指着",
        "focus": [
          "default_ptr",
          "mapping",
          "submit",
          "runs"
        ],
        "note": "谁指着这个 revision？提交那一刻解析成显式 revision 写进 run 定义，之后起 task 照抄，不按 family 取最新。"
      },
      {
        "id": "why-rederive",
        "label": "为何重派生",
        "focus": [
          "stack",
          "template",
          "derived",
          "retired"
        ],
        "note": "为什么重派生必要？revision 是快照、无继承：部署换了运行配置就得按新模板重注册，旧的转退休、镜像不动。"
      },
      {
        "id": "when-delete",
        "label": "何时能删",
        "focus": [
          "derived",
          "retired",
          "cleanup",
          "runs"
        ],
        "note": "旧 revision 什么时候才允许删？被替换只打退休标记；满静默期且无未到终态的 run 引用它，才注销并删除。"
      }
    ]
  },
