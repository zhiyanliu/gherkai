  "cards": [
    {
      "dot": "cyan",
      "title": "gherkai deploy 的四步",
      "items": [
        "① cdk 事务建资源，模板登记进 SSM",
        "② 同步基底：纯发行版要容器引擎，非纯发行版跳过",
        "③ 默认指针缺失才初始化，已有不动",
        "④ 模板换了才重派生，末尾顺带回收"
      ]
    },
    {
      "dot": "rose",
      "title": "删 revision 的两道闸",
      "items": [
        "退休或孤儿满静默期",
        "无未到终态的 run 引用它",
        "仍被某条映射引用的也留着",
        "故重推同名 variant 不动在跑的 run"
      ]
    }
  ]
