  "cards": [
    {
      "dot": "cyan",
      "title": "gherkai deploy 的四步",
      "items": [
        "① cdk 事务创建资源，模板登记进 SSM",
        "② 同步基础镜像：纯发行版需容器引擎，非纯发行版跳过",
        "③ 默认指针缺失时初始化，已存在则不修改",
        "④ 模板变更时重派生，末尾执行回收"
      ]
    },
    {
      "dot": "rose",
      "title": "删除 revision 的两个前置条件",
      "items": [
        "已退休或孤儿且满静默期",
        "无未到终态的 run 引用",
        "仍被映射引用的保留",
        "因此重推同名 variant 不影响运行中的 run"
      ]
    }
