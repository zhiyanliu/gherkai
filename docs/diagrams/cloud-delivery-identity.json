    "views": [
      {
        "id": "images-in",
        "label": "镜像入账",
        "focus": [
          "ghcr_base",
          "local_img",
          "ecr",
          "derived",
          "mapping"
        ],
        "note": "官方基础镜像与使用方 build 的镜像进入本账户、挂上 revision 的路径：先同步或推送进本账户 ECR，再从模板复制出该 variant 的 revision 并登记进映射。"
      },
      {
        "id": "who-points",
        "label": "指向关系",
        "focus": [
          "default_ptr",
          "mapping",
          "submit",
          "runs"
        ],
        "note": "指向该 revision 的环节：提交时解析为显式 revision 并写入 run 定义，起 task 时沿用该值，不按 family 取最新。"
      },
      {
        "id": "why-rederive",
        "label": "重派生动因",
        "focus": [
          "stack",
          "template",
          "derived",
          "retired"
        ],
        "note": "重派生的必要性：revision 是不可变快照、无继承；部署变更运行配置后须按新模板重新注册，旧 revision 转退休、镜像不变。"
      },
      {
        "id": "when-delete",
        "label": "删除条件",
        "focus": [
          "derived",
          "retired",
          "cleanup",
          "runs"
        ],
        "note": "旧 revision 允许删除的条件：被替换时仅标记退休；满静默期且无未到终态的 run 引用，才注销并删除。"
      }
    ]
  },
