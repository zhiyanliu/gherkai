    }
  },
  "stages": [
    { "label": "项目 steps 目录" },
    { "label": "提交之前：构建并推送" },
    { "label": "提交时刻" },
    { "label": "随 run 的定义" },
    { "label": "worker 进程内" }
  ],
  "nodes": [
    {
      "id": "src",
      "type": "frontend",
