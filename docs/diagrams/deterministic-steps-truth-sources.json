    {
      "id": "f-name-def",
      "from": "resolveName",
      "to": "defRevision",
      "label": "结果写入定义",
      "variant": "emphasis"
    },
    {
      "id": "f-def-local",
      "from": "defPath",
      "to": "workerLocal",
      "label": "读回后注入",
      "variant": "default"
