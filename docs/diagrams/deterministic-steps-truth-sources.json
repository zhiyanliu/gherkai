      "variant": "default",
      "fromSide": "top",
      "toSide": "left",
      "via": [
        [
          100,
          157
        ]
      ]
    },
    {
      "id": "f-src-image",
      "from": "src",
      "to": "image",
      "label": "复制进镜像",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "left",
