      "stage": 0,
      "row": 1,
      "width": 136
    },
    {
      "id": "image",
      "type": "cloud",
      "label": "构建进 variant 镜像",
      "sublabel": "推送 → 一条 revision",
      "stage": 1,
      "row": 2,
      "width": 136
    },
    {
      "id": "resolveDir",
      "type": "backend",
      "label": "解析一次目录",
      "sublabel": "按提交时的工作目录",
