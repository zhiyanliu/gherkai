  "cards": [
    {
      "dot": "cyan",
      "title": "判定的两个必要条件",
      "items": [
        "事件完整 ∧ 进程干净终止",
        "退出信号由父进程或平台观察给出，非 worker 自报"
      ]
    },
    {
      "dot": "violet",
      "title": "循环体的两种驱动",
      "items": [
        "run：全程在线的循环，命令终止则 run 中止",
        "submit：无状态单步推进，由本机后台进程或云端函数反复调用"
      ]
    },
    {
      "dot": "emerald",
      "title": "plan 的覆盖范围",
      "items": [
        "解析与分组纯本地、零费用",
        "另向每个引擎查询这些 step 各命中哪条确定性模式"
      ]
    }
  ]
