          "label": "落库与事件"
        },
        "messagebus": {
          "label": "驱动与派发"
        },
        "external": {
          "label": "worker（独立进程）"
        },
        "security": {
          "label": "退出观察"
        },
        "frontend": {
          "label": "使用者可见结果"
        }
      }
    }
  },
