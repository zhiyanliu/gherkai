  "cards": [
    { "dot": "cyan", "title": "链条是被事件串起来的", "items": ["云端函数各订阅自己的事件源，彼此之间不互相调用", "事件既是数据也是心跳：写一批就唤醒一次推进，没有常驻轮询", "主动调起只来自云外：查进度时发现卡住踢一脚、超时闹钟到点踢一脚"] },
    { "dot": "violet", "title": "多处同时被唤醒也安全", "items": ["抢 job 走条件写：同一个 job 只有一个赢家", "读模型只前进不后退，run 终态一次落定", "重复唤醒无害：每次都是从头重放事件算出该干什么"] },
    { "dot": "orange", "title": "冷启动那处不是薄壳", "items": ["与主推进同一份代码、同一套权限，跑的是完整的一步推进", "它有三个入口：新 run 落库、查进度发现卡住、超时闹钟到点"] }
