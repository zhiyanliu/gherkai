  "cards": [
    {
      "dot": "cyan",
      "title": "为什么由 worker 产",
      "items": [
        "step 判定成立那一刻，引擎材料还在手上：刚落盘的轨迹、内存里的执行记录",
        "不是命令行事后回头解析 SDK 产物",
        "只有调过 AI 的 step 有这条链：确定性命中与导航步不产证据明细"
      ]
    },
    {
      "dot": "violet",
      "title": "只解引用自有格式的那一份",
      "items": [
        "引擎原生产物只当链接原样搬出——它们的格式随 SDK 版本漂，解析它等于把引擎知识搬进命令行",
        "读字节只有一个入口：本机路径与云端对象走同一套解析"
      ]
    },
    {
      "dot": "amber",
      "title": "截图只写地址，不等字节",
      "items": [
        "地址用上传器的同一套规则确定性算出，所以能先写进证据明细",
        "判定因此不被网络拖住：本机档字节落盘即在，云端档随后异步补上"
      ]
    }
  ]
