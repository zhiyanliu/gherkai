{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "判定的逐层归约：一票 → run",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      360
    ]
  },
  "stages": [
    {
      "label": "一票"
    },
    {
      "label": "step"
    },
    {
      "label": "scenario"
    },
    {
      "label": "job（= scope）"
    },
    {
      "label": "run"
    }
  ],
  "nodes": [
    {
      "id": "vote",
      "type": "external",
      "label": "布尔返回值",
      "sublabel": "一次 AI 调用",
      "stage": 0,
      "row": 0,
      "yOffset": 14,
      "tag": "worker 侧"
    },
    {
      "id": "step",
      "type": "external",
      "label": "step 结论",
      "sublabel": "AI 断言 / 确定性 step",
      "stage": 1,
      "row": 0,
      "yOffset": 14,
      "tag": "worker 侧"
    },
    {
      "id": "scenario",
      "type": "external",
      "label": "scenario 结论",
      "sublabel": "逐 step 汇总",
      "stage": 2,
      "row": 0,
      "yOffset": 14,
      "tag": "worker 侧"
    },
    {
      "id": "job",
      "type": "backend",
      "label": "job 收场态",
      "sublabel": "运行结束后才归约",
      "stage": 3,
      "row": 0,
      "yOffset": 14,
      "tag": "core 侧"
    },
    {
      "id": "run",
      "type": "backend",
      "label": "run 判定",
      "sublabel": "整个 run 的最终结论",
      "stage": 4,
      "row": 0,
      "yOffset": 14,
      "tag": "core 侧"
    }
  ],
  "flows": [
    {
      "id": "vote-step",
      "from": "vote",
      "to": "step",
      "label": "多数票",
      "variant": "emphasis"
    },
    {
      "id": "step-scenario",
      "from": "step",
      "to": "scenario",
      "label": "任一 error 最重",
      "variant": "emphasis"
    },
    {
      "id": "scenario-job",
      "from": "scenario",
      "to": "job",
      "label": "上报给 core",
      "classification": "跨进程事件",
      "variant": "emphasis"
    },
    {
      "id": "job-run",
      "from": "job",
      "to": "run",
      "label": "同一条规则",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "上层只归约",
      "items": [
        "core 不重算票、不重判 step，worker 上报的结论原样进入上一层归约",
        "worker 只上报 step 与 scenario 两级；job 与 run 的判定在 core",
        "同步 run 与后台批量运行共用同一份归约代码，两条路径收敛到同一终值"
      ]
    },
    {
      "dot": "amber",
      "title": "直链之外的三处旁路",
      "items": [
        "上游 step 报 error 后被跳过的 step 不进入 scenario 归约",
        "job 未启动或运行中被终止时，按中止来源直接定态，不做 scenario 归约",
        "run 层在归约入口先滤掉不构成结论的状态"
      ]
    }
  ]
}
