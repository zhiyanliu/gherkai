    },
    {
      "id": "e-exit-blk",
      "from": "judgeExit",
      "to": "blkExit",
      "label": "不是后台批次",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 54,
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "无闸门时的后果",
      "items": [
        "前台跑法在云端档同样写入这两张表，云端函数会被这些记录唤醒",
        "结果是同一 scope 启动两个 task：前台已启动一个，云端推进器另启动一个"
      ]
    },
    {
      "dot": "cyan",
      "title": "两道闸门，判据同源",
      "items": [
        "第一道位于事件源过滤：仅接收带后台标记的新 run 落库",
        "事件批次与任务停止事件均不带此标记，只能进入函数后反查该 run",
        "第二道在装配前判断，冷启动的各个入口同样经过"
      ]
    },
    {
      "dot": "violet",
      "title": "另两个判点防范其他情形",
      "items": [
        "「是否已结束」防范的是改写已落定的结果",
        "退出观察者这道防范的是无正文的退出记录混入前台 run 的事件流"
      ]
    }
  ]
}
