      "lane": "laneExit",
      "col": 4,
      "type": "security",
      "label": "退出观察者判断",
      "sublabel": "判据为同一标记",
      "width": 176
    },
    {
      "id": "goExit",
      "lane": "laneExit",
      "col": 5,
      "type": "backend",
      "label": "写入退出记录",
