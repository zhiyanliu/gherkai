  "cards": [
    {
      "dot": "rose",
      "title": "不加闸门会怎样",
      "items": [
        "前台跑法在云端档也往同两张表里写，云端函数照样被它的记录唤醒",
        "结果是同一个 scope 被起两个 task：前台在跑，云端又替它起一个"
      ]
    },
    {
      "dot": "cyan",
      "title": "两道闸门，同一个判据",
      "items": [
        "订阅侧那道写在事件源过滤里：只收带后台标记的新 run 落库",
        "事件与任务停止事件上都没有这个标记，只能进了函数再回头查这个 run",
        "后一道在装配前就判，被踢起来的冷启动同样要过"
      ]
    },
    {
      "dot": "violet",
      "title": "另两个判点防的是别的事",
      "items": [
        "「收尾了吗」防的是改写已落定的结果",
        "退出观察那道防的是没有正文的退出记录混进前台 run 的事件流"
      ]
    }
  ]
