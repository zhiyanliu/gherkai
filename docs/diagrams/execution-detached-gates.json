{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "两道判断：云端推进函数只处理带后台标记的 run",
    "output": "execution-detached-gates.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "legend": {
      "mode": "auto",
      "entries": {
        "database": {
          "label": "订阅侧的事件源"
        },
        "security": {
          "label": "判点"
        },
        "external": {
          "label": "挡在链外"
        },
        "backend": {
          "label": "放行后的动作"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "laneKick",
      "label": "冷启动路径"
    },
    {
      "id": "laneStep",
      "label": "主推进路径"
    },
    {
      "id": "laneBlocked",
      "label": "挡在链外",
      "variant": "exception"
    }
  ],
  "phases": [
    {
      "id": "phSrc",
      "label": "事件源层过滤",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "phJudge",
      "label": "函数内判断：不通过即挡下",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "phGo",
      "label": "放行：链正常贯通",
      "fromCol": 4,
      "toCol": 4
    }
  ],
  "mainPath": [
    "judgeDetached",
    "judgeSettled",
    "goStep"
  ],
  "semanticChecks": {
    "allowedRoots": [
      "srcNew",
      "judgeDetached"
    ],
    "allowedTerminals": [
      "goKick",
      "goStep",
      "blkKick",
      "blkAct",
      "blkRewrite"
    ],
    "requiredEdges": [
      {
        "from": "judgeDetached",
        "to": "judgeSettled"
      }
    ]
  },
  "nodes": [
    {
      "id": "srcNew",
      "lane": "laneKick",
      "col": 0,
      "type": "database",
      "label": "新 run 落库",
      "sublabel": "后台标记过滤",
      "width": 148
    },
    {
      "id": "goKick",
      "lane": "laneKick",
      "col": 4,
      "type": "backend",
      "label": "起首批 worker",
      "width": 148
    },
    {
      "id": "judgeDetached",
      "lane": "laneStep",
      "col": 2,
      "type": "security",
      "label": "是否后台执行",
      "sublabel": "事件不带此标记",
      "width": 152
    },
    {
      "id": "judgeSettled",
      "lane": "laneStep",
      "col": 3,
      "type": "security",
      "label": "run 是否已结束",
      "sublabel": "防范另一件事",
      "width": 176
    },
    {
      "id": "goStep",
      "lane": "laneStep",
      "col": 4,
      "type": "backend",
      "label": "推进一步",
      "width": 148
    },
    {
      "id": "blkKick",
      "lane": "laneBlocked",
      "col": 1,
      "type": "external",
      "label": "不被唤醒",
      "sublabel": "事件源过滤",
      "width": 148
    },
    {
      "id": "blkAct",
      "lane": "laneBlocked",
      "col": 2,
      "type": "external",
      "label": "不执行推进",
      "sublabel": "只跳过该 run",
      "width": 152
    },
    {
      "id": "blkRewrite",
      "lane": "laneBlocked",
      "col": 3,
      "type": "external",
      "label": "不改写结果",
      "sublabel": "已落定为终态",
      "width": 176
    }
  ],
  "edges": [
    {
      "id": "e-new-go",
      "from": "srcNew",
      "to": "goKick",
      "label": "是后台 run",
      "variant": "default",
      "role": "branch"
    },
    {
      "id": "e-new-blk",
      "from": "srcNew",
      "to": "blkKick",
      "label": "不是后台 run",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-detached-settled",
      "from": "judgeDetached",
      "to": "judgeSettled",
      "label": "是 → 下一判点",
      "fromSide": "right",
      "toSide": "left",
      "route": "straight",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "e-detached-blk",
      "from": "judgeDetached",
      "to": "blkAct",
      "label": "不是后台执行",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 28,
      "variant": "security",
      "role": "error"
    },
    {
      "id": "e-settled-go",
      "from": "judgeSettled",
      "to": "goStep",
      "label": "未结束",
      "variant": "emphasis",
      "role": "main"
    },
    {
      "id": "e-settled-blk",
      "from": "judgeSettled",
      "to": "blkRewrite",
      "label": "已结束",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 28,
      "variant": "security",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "判断的对象",
      "items": [
        "云端后端只有 submit 提交的后台 run，建 run 时都写下后台标记",
        "两道判断对这些 run 恒放行，没有后台标记的 run 才被挡下"
      ]
    },
    {
      "dot": "cyan",
      "title": "两道拦截，判据同源",
      "items": [
        "第一道位于事件源过滤：仅接收带后台标记的新 run 落库",
        "事件批次不带此标记，只能进入函数后反查该 run",
        "第二道在装配前判断，冷启动的各个入口同样经过"
      ]
    },
    {
      "dot": "violet",
      "title": "这两道判断之外",
      "items": [
        "「是否已结束」防范的是改写已落定的结果",
        "退出观察者不读这个标记：凡带 run 与 scope 标识的任务停止都写退出记录"
      ]
    }
  ]
}
